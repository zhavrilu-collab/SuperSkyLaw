APP_NAME=SuperSkyLaw
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8006

APP_LOCALE=hr
APP_FALLBACK_LOCALE=hr
APP_FAKER_LOCALE=hr_HR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin konzola sync (isti ključ kao SAAS_WEBHOOK_SECRET u Core-u)
ADMIN_SYNC_API_KEY=dev-sync-key-change-me
ADMIN_CONSOLE_API_URL=http://127.0.0.1:8001
ADMIN_CONSOLE_APPLICATION_SLUG=legal-saas
ADMIN_CONSOLE_WEBHOOK_SECRET=dev-sync-key-change-me
ADMIN_CONSOLE_WEBHOOK_URL=http://127.0.0.1:8001/api/webhooks/tenants/registered

# Core identity (Faza B/D)
IDENTITY_CORE_AUTH_ENABLED=true
IDENTITY_CORE_API_URL=http://127.0.0.1:8001
IDENTITY_CORE_API_VERSION=v1
IDENTITY_GOOGLE_OAUTH_ENABLED=false
IDENTITY_MICROSOFT_OAUTH_ENABLED=false
IDENTITY_UNIFIED_LOGIN_ENABLED=true

# Sudski registar (javni API, samo pravne osobe)
SUDREG_BASE_URL=https://sudreg-data.gov.hr/api
SUDREG_CLIENT_ID=
SUDREG_CLIENT_SECRET=

# Moj-eRačun. Prazan URL ostavlja e-račun pripremljen, bez slanja.
MOJ_ERACUN_URL=
MOJ_ERACUN_USERNAME=
MOJ_ERACUN_PASSWORD=

# Kvalificirani e-potpis. Prazan URL ostavlja zahtjev pripremljen, dokument nije potpisan.
ESIGN_URL=
ESIGN_USERNAME=
ESIGN_PASSWORD=

# SMS samo uz privolu stranke. Prazan URL ne šalje i ne naplaćuje.
SMS_URL=
SMS_TOKEN=
SMS_COST_CENTS=8

# Narodne novine, službeni tekstovi zakona. Najviše 3 zahtjeva u sekundi.
NN_BASE_URL=https://narodne-novine.nn.hr
# Opcionalno: putanja do cacert.pem ako PHP ne vjeruje izdavatelju (stari CA paket).
# NN_CA_BUNDLE=
